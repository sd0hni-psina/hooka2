# Copy to /opt/hookah/.env on the VPS. GitHub secrets: VPS_HOST, VPS_USER, VPS_SSH_KEY.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=
# At least 32 characters, e.g. openssl rand -hex 32. The api refuses to start with less.
JWT_SECRET=
ACCESS_TTL=30m
REFRESH_TTL=2160h
SCHEDULER_TICK=1s
PUSH_TICK=5s
PUSH_PROVIDER=fake
EXPO_ACCESS_TOKEN=
LOG_LEVEL=info
CORS_ORIGINS=
DB_MAX_CONNS=10
