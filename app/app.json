{
  "expo": {
    "name": "Кальянный таймер",
    "slug": "hookah-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.hookah.timer",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.hookah.timer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store"
    ],
    "scheme": "hookah",
    "backgroundColor": "#0E0F13",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F13"
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#4C8DFF",
      "androidMode": "default"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "154d06ec-d150-4f4a-be8c-f57541e49249"
      }
    },
    "owner": "sd0hni_psina"
  }
}
